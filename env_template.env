# Copy to .env at the repo root, then fill in. Every stack symlinks its own
# .env -> ../.env (or ../../.env), so this one file feeds all of them.
#   cp env_template.env .env && chmod 600 .env
#
# Secrets that support *_FILE / docker secrets live in _secrets/ instead of
# here -- see the "Secrets" section at the bottom. Neither .env nor _secrets/
# is tracked by git.

# --- Host paths -------------------------------------------------------------
SSD_PATH=                   # fast local storage for configs/databases
HDD_PATH=                   # bulk storage (NFS/array) for media and backups

# --- Identity ---------------------------------------------------------------
PUID=
PGID=
TZ=                         # e.g. America/New_York

# --- Networking -------------------------------------------------------------
DOMAIN_NAME=                # apex domain; Caddy serves *.${DOMAIN_NAME}
ACME_EMAIL=                 # Let's Encrypt registration address
SERVER_LAN_IP=              # used for Prometheus --web.external-url
LAN_NETWORK=                # CIDR allowed to bypass the VPN, e.g. 192.168.1.0/24

# --- VPN (media stack) ------------------------------------------------------
VPN_USER=                   # PIA credentials; consumed by sabnzbdvpn + qbittorrentvpn
VPN_PASS=

# --- Immich -----------------------------------------------------------------
UPLOAD_LOCATION=
DB_DATA_LOCATION=
IMMICH_VERSION=
IMMICH_DB_USERNAME=
IMMICH_DB_PASSWORD=
IMMICH_DB_DATABASE_NAME=

# --- Authentik --------------------------------------------------------------
PG_PASS=
AUTHENTIK_SECRET_KEY=       # openssl rand -base64 60

# --- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=     # only applied on first start; change later via UI

# --- Game servers -----------------------------------------------------------
SE_INSTANCE_NAME=
SE_PUBLIC_IP=
PALWORLD_SERVER_PASSWORD=
PALWORLD_ADMIN_PASSWORD=

# --- Secrets (files, not variables) -----------------------------------------
# Create these under _secrets/ with mode 600. They are mounted as docker
# secrets rather than passed as environment variables:
#   cloudflare_api_token.txt        Caddy DNS-01 challenge (Zone:Read + DNS:Edit)
#   ddns_api_key.txt                cloudflare-ddns record updates
#   ntfy_alertmanager_password.txt  Alertmanager -> ntfy basic auth
#   ntfy_jeff_password.txt          ntfy user account
#   simple_fin_token.txt            actual-helpers bank sync
#   simple_fin_auth.txt             actual-helpers bank sync
